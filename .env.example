# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Leave DATABASE_URL empty or comment out to use embedded PostgreSQL (PGLite) in ./data/pgdata
# Or set to external PostgreSQL: postgres://username:password@localhost:5432/reporting_db
DATABASE_URL=
DATABASE_DIR=./data/pgdata

# Authentication Secrets
JWT_SECRET=super-secure-production-jwt-secret-key-change-in-prod-min-32-chars
JWT_EXPIRES_IN=7d

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
